# Copy to deploy/.env and change the passwords. deploy/.env is not committed to git.
DB_NAME=glpi
DB_USER=glpi
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Port on your Mac: http://localhost:8080
GLPI_PORT=8080

# Language for a new install (en_GB, fr_FR, fa_IR, ...)
GLPI_LANGUAGE=en_GB

# 1 = load the Project reports demo data once, to try the reports. Remove with:
#   docker compose -f deploy/compose.yaml exec app runuser -u www-data -- php bin/console plugins:projectreports:demo --remove
GLPI_DEMO_DATA=0

TZ=Asia/Tehran
