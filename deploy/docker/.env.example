# Copy this file to .env and point it at your EXISTING GLPI 11.0.11 folders.
# These must be the folders your current GLPI uses, so it keeps the same
# database connection, encryption key, documents and plugins.

# Folder containing config_db.php and glpicrypt.key
GLPI_CONFIG_DIR=/var/www/glpi/config

# Folder containing _cache, _uploads, _pictures, ...
GLPI_FILES_DIR=/var/www/glpi/files

# Folder containing marketplace plugins
GLPI_MARKETPLACE_DIR=/var/www/glpi/marketplace

# Port to publish GLPI on
GLPI_PORT=8080
