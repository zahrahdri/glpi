{#
 # Split-screen login page: branded hero panel on the left, sign-in form on the right.
 # This page does not extend layout/page_card_notlogged.html.twig, so the other
 # anonymous pages (errors, lost password, ...) keep the default card layout.
 #}

{% set theme = current_theme() %}
{% set css_files = [
    {'path': 'lib/base.css'},
    {'path': 'lib/tabler.css'},
    {'path': 'css/glpi.scss'},
    {'path': 'css/core_palettes.scss'}
] %}
{% for theme_path in get_custom_themes_paths() %}
    {% set css_files = css_files|merge([{'path': theme_path}]) %}
{% endfor %}

{% set js_files = [
    {'path': 'lib/base.js'},
    {'path': 'js/common.js'},
    {'path': 'lib/fuzzy.js'}
]|merge(get_plugins_js_scripts_files(true)) %}
{% set js_modules = get_plugins_js_modules_files(true) %}
{% set custom_header_tags = [] %}
{% set is_anonymous_page = true %}

{% set help_url = config('central_doc_url') is not empty
    ? config('central_doc_url')
    : 'https://glpi-project.org/documentation' %}

{{ include('layout/parts/head.html.twig') }}
<body class="welcome-anonymous login-split">
    <div class="skip-links">
        <a class="visually-hidden-focusable skip-link" href="#login-form">{{ __('Go to main content') }}</a>
    </div>

    <main id="page" class="page-anonymous login-page" role="main" tabindex="-1">
        <section class="login-hero" aria-hidden="true">
            <div class="login-hero-grid"></div>
            <div class="login-hero-inner">
                <span class="login-hero-logo" title="GLPI"></span>

                <div class="login-hero-text">
                    <h1>{{ __('Plan capacity. Forecast growth. Stay ahead.') }}</h1>
                    <p>{{ __('One view of your infrastructure: track what you have, see how it is used and know what you will need next.') }}</p>
                </div>

                <ul class="login-hero-features">
                    <li><i class="ti ti-server-2"></i>{{ __('Infrastructure inventory') }}</li>
                    <li><i class="ti ti-gauge"></i>{{ __('Capacity planning') }}</li>
                    <li><i class="ti ti-chart-line"></i>{{ __('Growth forecasting') }}</li>
                </ul>
            </div>
        </section>

        <section class="login-panel">
            <div class="login-panel-inner">
                <span class="login-panel-logo" title="GLPI"></span>

                <form id="login-form" action="{{ path('front/login.php') }}" method="post" autocomplete="off" data-submit-once>
                    <input type="hidden" name="noAUTO" value="{{ noAuto }}"/>
                    <input type="hidden" name="redirect" value="{{ redirect }}"/>
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>

                    <h2 class="login-title">{{ __('Login to your account') }}</h2>

                    {% if text_login|length > 0 %}
                        <div class="rich_text_container login-text mb-4">
                            {{ text_login|safe_html }}
                        </div>
                    {% endif %}

                    <div class="mb-3">
                        <label class="form-label" for="login_name">{{ __('Login') }}</label>
                        <div class="input-icon">
                            <span class="input-icon-addon"><i class="ti ti-user"></i></span>
                            <input type="text" class="form-control" id="login_name" name="login_name" placeholder="" autocomplete="username"/>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="login_password">{{ __('Password') }}</label>
                        <div class="input-icon">
                            <span class="input-icon-addon"><i class="ti ti-lock"></i></span>
                            <input type="password" class="form-control" id="login_password" name="login_password" placeholder="" autocomplete="current-password"/>
                        </div>
                    </div>

                    {% if config('display_login_source') %}
                        <div class="mb-3">
                            <label class="form-label" for="dropdown_auth{{ rand }}">{{ __('Login source') }}</label>
                            {{ auth_dropdown_login|raw }}
                        </div>
                    {% endif %}

                    {% if config('login_remember_time') %}
                        <div class="mb-3">
                            <label class="form-check" for="login_remember">
                                <input type="checkbox" class="form-check-input" id="login_remember" name="login_remember" {{ config('login_remember_default') ? 'checked' : '' }}/>
                                <span class="form-check-label">{{ __('Remember me') }}</span>
                            </label>
                        </div>
                    {% endif %}

                    <div class="form-footer mt-4">
                        <button type="submit" name="submit" class="btn btn-primary btn-login w-100">
                            {{ __('Sign in') }}
                        </button>
                        {% if show_lost_password %}
                            <div class="text-center mt-3 forgot_password {{ config('display_login_source') ? 'd-none' : '' }}">
                                <a href="{{ path('front/lostpassword.php?lostpassword=1') }}">
                                    {{ __('Forgotten password?') }}
                                </a>
                            </div>
                            {% if config('display_login_source') %}
                                <script>
                                    $(() => {
                                        const toggleForgot = (val) => {
                                            $('.forgot_password').toggleClass('d-none', val !== 'local');
                                        };
                                        toggleForgot($('select[name="auth"]').val());
                                        $('select[name="auth"]').on('change', function () {
                                            toggleForgot($(this).val());
                                        });
                                    });
                                </script>
                            {% endif %}
                        {% endif %}
                    </div>

                    {% if right_panel %}
                        <div class="login-plugins mt-4">
                            {{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::DISPLAY_LOGIN')) }}
                        </div>
                    {% endif %}

                    {% if config('use_public_faq') %}
                        <div class="mt-4">
                            <a class="btn btn-outline-secondary w-100" href="{{ path('front/helpdesk.faq.php') }}">
                                <i class="ti ti-help"></i>&nbsp;{{ __('FAQ') }}
                            </a>
                        </div>
                    {% endif %}
                </form>

                <footer class="login-footer">
                    <div class="login-copyright">{{ copyright_message|raw }}</div>
                    <a class="login-help" href="{{ help_url }}" target="_blank" rel="noopener noreferrer">
                        <i class="ti ti-help-circle"></i>{{ __('Help') }}
                    </a>
                </footer>
            </div>
        </section>
    </main>

    {% if must_call_cron %}
        <div style="background-image: url('{{ path('/front/cron.php') }}');"></div>
    {% endif %}

    <script type="text/javascript">
        $(function () {
            $('#login_name').focus();
        });
    </script>
</body>
</html>
